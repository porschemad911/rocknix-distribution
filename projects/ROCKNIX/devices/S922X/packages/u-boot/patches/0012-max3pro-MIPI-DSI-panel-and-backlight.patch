diff --git a/drivers/video/sitronix-st7701.c b/drivers/video/sitronix-st7701.c
new file mode 100644
index 00000000..e28932ef
--- /dev/null
+++ b/drivers/video/sitronix-st7701.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Sitronix ST7701 MIPI DSI panel: the ODROID-GO Ultra / Powkiddy RGB10 Max 3
+ * Pro 480x854 panel (Elida KD50T048A).
+ *
+ * The init sequence and the mode are the ones of the Linux
+ * panel-sitronix-st7701 driver ("odroid,go-ultra-panel"), which took the
+ * sequence from the Hardkernel ODROID-GO Ultra BSP U-Boot.
+ */
+
+#include <backlight.h>
+#include <dm.h>
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <asm/gpio.h>
+#include <dm/device_compat.h>
+#include <linux/delay.h>
+#include <power/regulator.h>
+
+struct st7701_panel_priv {
+	struct udevice *vcc;
+	struct udevice *iovcc;
+	struct gpio_desc reset;
+	struct udevice *backlight;
+};
+
+static const struct display_timing go_ultra_timing = {
+	.pixelclock.typ		= 29170000,
+	.hactive.typ		= 480,
+	.hfront_porch.typ	= 12,
+	.hsync_len.typ		= 12,
+	.hback_porch.typ	= 38,
+	.vactive.typ		= 854,
+	.vfront_porch.typ	= 2,
+	.vsync_len.typ		= 19,
+	.vback_porch.typ	= 22,
+};
+
+#define dsi_dcs_write_seq(device, seq...) do {					\
+		static const u8 d[] = { seq };					\
+		int ret;							\
+		ret = mipi_dsi_dcs_write_buffer(device, d, ARRAY_SIZE(d));	\
+		if (ret < 0)							\
+			return ret;						\
+	} while (0)
+
+static int st7701_go_ultra_init(struct mipi_dsi_device *device)
+{
+	dsi_dcs_write_seq(device, MIPI_DCS_SOFT_RESET);
+	mdelay(5);
+	dsi_dcs_write_seq(device, MIPI_DCS_EXIT_SLEEP_MODE);
+	mdelay(120);
+
+	/* Command2, BK0 */
+	dsi_dcs_write_seq(device, 0xff, 0x77, 0x01, 0x00, 0x00, 0x10);
+	dsi_dcs_write_seq(device, 0xc0, 0xe9, 0x03);
+	dsi_dcs_write_seq(device, 0xc1, 0x11, 0x02);
+	dsi_dcs_write_seq(device, 0xc2, 0x31, 0x08);
+	dsi_dcs_write_seq(device, 0xcc, 0x10);
+	dsi_dcs_write_seq(device, 0xb0, 0x00, 0x0d, 0x14, 0x0d, 0x10, 0x05,
+			  0x02, 0x08, 0x08, 0x1e, 0x05, 0x13, 0x11, 0xa3, 0x29,
+			  0x18);
+	dsi_dcs_write_seq(device, 0xb1, 0x00, 0x0c, 0x14, 0x0c, 0x10, 0x05,
+			  0x03, 0x08, 0x07, 0x20, 0x05, 0x13, 0x11, 0xa4, 0x29,
+			  0x18);
+
+	/* Command2, BK1 */
+	dsi_dcs_write_seq(device, 0xff, 0x77, 0x01, 0x00, 0x00, 0x11);
+	dsi_dcs_write_seq(device, 0xb0, 0x6c);
+	dsi_dcs_write_seq(device, 0xb1, 0x43);
+	dsi_dcs_write_seq(device, 0xb2, 0x07);
+	dsi_dcs_write_seq(device, 0xb3, 0x80);
+	dsi_dcs_write_seq(device, 0xb5, 0x47);
+	dsi_dcs_write_seq(device, 0xb7, 0x85);
+	dsi_dcs_write_seq(device, 0xb8, 0x20);
+	dsi_dcs_write_seq(device, 0xb9, 0x10);
+	dsi_dcs_write_seq(device, 0xc1, 0x78);
+	dsi_dcs_write_seq(device, 0xc3, 0x78);
+	dsi_dcs_write_seq(device, 0xd0, 0x88);
+	mdelay(120);
+
+	/* Gate driver (GIP) setup */
+	dsi_dcs_write_seq(device, 0xe0, 0x00, 0x00, 0x02);
+	dsi_dcs_write_seq(device, 0xe1, 0x08, 0x00, 0x0a, 0x00, 0x07, 0x00,
+			  0x09, 0x00, 0x00, 0x33, 0x33);
+	dsi_dcs_write_seq(device, 0xe2, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	dsi_dcs_write_seq(device, 0xe3, 0x00, 0x00, 0x33, 0x33);
+	dsi_dcs_write_seq(device, 0xe4, 0x44, 0x44);
+	dsi_dcs_write_seq(device, 0xe5, 0x0e, 0x60, 0xa0, 0xa0, 0x10, 0x60,
+			  0xa0, 0xa0, 0x0a, 0x60, 0xa0, 0xa0, 0x0c, 0x60, 0xa0,
+			  0xa0);
+	dsi_dcs_write_seq(device, 0xe6, 0x00, 0x00, 0x33, 0x33);
+	dsi_dcs_write_seq(device, 0xe7, 0x44, 0x44);
+	dsi_dcs_write_seq(device, 0xe8, 0x0d, 0x60, 0xa0, 0xa0, 0x0f, 0x60,
+			  0xa0, 0xa0, 0x09, 0x60, 0xa0, 0xa0, 0x0b, 0x60, 0xa0,
+			  0xa0);
+	dsi_dcs_write_seq(device, 0xeb, 0x02, 0x01, 0xe4, 0xe4, 0x44, 0x00,
+			  0x40);
+	dsi_dcs_write_seq(device, 0xec, 0x02, 0x01);
+	dsi_dcs_write_seq(device, 0xed, 0xab, 0x89, 0x76, 0x54, 0x01, 0xff,
+			  0xff, 0xff, 0xff, 0xff, 0xff, 0x10, 0x45, 0x67, 0x98,
+			  0xba);
+
+	/* Disable Command2 */
+	dsi_dcs_write_seq(device, 0xff, 0x77, 0x01, 0x00, 0x00, 0x00);
+	dsi_dcs_write_seq(device, 0x3a, 0x70);
+	dsi_dcs_write_seq(device, 0x53, 0xec);
+	dsi_dcs_write_seq(device, 0x55, 0xb3);
+	dsi_dcs_write_seq(device, 0x5e, 0xff);
+	dsi_dcs_write_seq(device, MIPI_DCS_SET_DISPLAY_ON);
+	mdelay(50);
+
+	return 0;
+}
+
+/*
+ * Power a supply the way the Linux regulator core would: apply a fixed
+ * voltage from the constraints first. U-Boot only does that itself for
+ * boot-on/always-on regulators, and vcc_lcd (RK817 LDO8) is neither, so
+ * after a power-off it would come up at the PMIC's reset voltage; after a
+ * reboot it just keeps the 3.3 V Linux left.
+ */
+static int st7701_supply_on(struct udevice *dev, struct udevice *supply)
+{
+	struct dm_regulator_uclass_plat *uc = dev_get_uclass_plat(supply);
+	int ret;
+
+	if (uc->min_uV > 0 && uc->min_uV == uc->max_uV) {
+		ret = regulator_set_value(supply, uc->min_uV);
+		if (ret && ret != -ENOSYS) {
+			dev_err(dev, "%s: cannot set %d uV (%d)\n", uc->name,
+				uc->min_uV, ret);
+			return ret;
+		}
+	}
+
+	ret = regulator_set_enable_if_allowed(supply, true);
+	if (ret) {
+		dev_err(dev, "%s: cannot enable (%d)\n", uc->name, ret);
+		return ret;
+	}
+
+	/* No serial port on these boards: leave a trace in the console log */
+	printf("Panel: %s %d uV, %s\n", uc->name, regulator_get_value(supply),
+	       regulator_get_enable(supply) ? "on" : "off");
+
+	return 0;
+}
+
+static int st7701_panel_enable_backlight(struct udevice *dev)
+{
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+	struct st7701_panel_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = mipi_dsi_attach(plat->device);
+	if (ret < 0)
+		return ret;
+
+	/* Power and reset, as the Linux driver's prepare() */
+	dm_gpio_set_value(&priv->reset, 0);
+	if (priv->vcc) {
+		ret = st7701_supply_on(dev, priv->vcc);
+		if (ret)
+			return ret;
+	}
+	if (priv->iovcc && priv->iovcc != priv->vcc) {
+		ret = st7701_supply_on(dev, priv->iovcc);
+		if (ret)
+			return ret;
+	}
+	mdelay(120);
+	dm_gpio_set_value(&priv->reset, 1);
+	mdelay(150);
+
+	ret = st7701_go_ultra_init(plat->device);
+	if (ret) {
+		dev_err(dev, "init sequence failed %d\n", ret);
+		return ret;
+	}
+
+	if (priv->backlight) {
+		ret = backlight_enable(priv->backlight);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int st7701_panel_set_backlight(struct udevice *dev, int percent)
+{
+	struct st7701_panel_priv *priv = dev_get_priv(dev);
+
+	if (!priv->backlight)
+		return 0;
+
+	return backlight_set_brightness(priv->backlight, percent);
+}
+
+static int st7701_panel_get_display_timing(struct udevice *dev,
+					   struct display_timing *timings)
+{
+	memcpy(timings, &go_ultra_timing, sizeof(*timings));
+
+	return 0;
+}
+
+static int st7701_panel_of_to_plat(struct udevice *dev)
+{
+	struct st7701_panel_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (CONFIG_IS_ENABLED(DM_REGULATOR)) {
+		ret = device_get_supply_regulator(dev, "VCC-supply", &priv->vcc);
+		if (ret && ret != -ENOENT)
+			dev_warn(dev, "cannot get VCC supply (%d)\n", ret);
+		ret = device_get_supply_regulator(dev, "IOVCC-supply",
+						  &priv->iovcc);
+		if (ret && ret != -ENOENT)
+			dev_warn(dev, "cannot get IOVCC supply (%d)\n", ret);
+	}
+
+	ret = uclass_get_device_by_phandle(UCLASS_PANEL_BACKLIGHT, dev,
+					   "backlight", &priv->backlight);
+	if (ret) {
+		dev_warn(dev, "failed to get backlight (%d)\n", ret);
+		priv->backlight = NULL;
+	}
+
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset,
+				   GPIOD_IS_OUT);
+	if (ret && ret != -ENOENT) {
+		dev_err(dev, "cannot get reset GPIO (%d)\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int st7701_panel_probe(struct udevice *dev)
+{
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+
+	/* fill characteristics of DSI data link */
+	plat->lanes = 2;
+	plat->format = MIPI_DSI_FMT_RGB888;
+	plat->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			   MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static const struct panel_ops st7701_panel_ops = {
+	.enable_backlight = st7701_panel_enable_backlight,
+	.set_backlight = st7701_panel_set_backlight,
+	.get_display_timing = st7701_panel_get_display_timing,
+};
+
+static const struct udevice_id st7701_panel_ids[] = {
+	{ .compatible = "odroid,go-ultra-panel" },
+	{ }
+};
+
+U_BOOT_DRIVER(st7701_panel) = {
+	.name		= "st7701_panel",
+	.id		= UCLASS_PANEL,
+	.of_match	= st7701_panel_ids,
+	.ops		= &st7701_panel_ops,
+	.of_to_plat	= st7701_panel_of_to_plat,
+	.probe		= st7701_panel_probe,
+	.plat_auto	= sizeof(struct mipi_dsi_panel_plat),
+	.priv_auto	= sizeof(struct st7701_panel_priv),
+};
