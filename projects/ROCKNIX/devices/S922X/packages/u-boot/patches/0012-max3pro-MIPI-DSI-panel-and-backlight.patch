diff --git a/drivers/video/meson/meson_dw_mipi_dsi.c b/drivers/video/meson/meson_dw_mipi_dsi.c
new file mode 100644
index 00000000..c924e5e9
--- /dev/null
+++ b/drivers/video/meson/meson_dw_mipi_dsi.c
@@ -0,0 +1,559 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic Meson G12A/G12B/SM1 MIPI DSI glue for the Synopsys DW MIPI DSI host
+ *
+ * Based on the Linux meson_dw_mipi_dsi driver:
+ * Copyright (C) 2021 BayLibre, SAS
+ * Author: Neil Armstrong <narmstrong@baylibre.com>
+ * Copyright (C) 2015 Amlogic, Inc. All rights reserved.
+ *
+ * Linux sets the DSI clocks through the common clock framework, which the
+ * U-Boot G12A clock driver doesn't model (GP0 PLL, VCLK2, ENCL, DSI pixel
+ * clock), so this driver programs them in the HHI registers directly, the
+ * way the Amlogic BSP U-Boot does:
+ *
+ *   GP0 PLL = DSI lane bit rate  -> mipi_dsi_pxclk (DSI host/PHY bit clock)
+ *   GP0 PLL / (bpp / lanes)      -> VCLK2 -> cts_encl (ENCL pixel clock)
+ */
+
+#include <clk.h>
+#include <div64.h>
+#include <display.h>
+#include <dm.h>
+#include <dsi_host.h>
+#include <generic-phy.h>
+#include <log.h>
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <phy-mipi-dphy.h>
+#include <regmap.h>
+#include <reset.h>
+#include <syscon.h>
+#include <video_bridge.h>
+#include <asm/io.h>
+#include <dm/device_compat.h>
+#include <dm/lists.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/iopoll.h>
+
+#include "meson_registers.h"
+
+/* DSI TOP registers, in the DSI host register space */
+#define MIPI_DSI_TOP_SW_RESET		0x3c0
+#define		MIPI_DSI_TOP_SW_RESET_DWC	BIT(0)
+#define		MIPI_DSI_TOP_SW_RESET_INTR	BIT(1)
+#define		MIPI_DSI_TOP_SW_RESET_DPI	BIT(2)
+#define		MIPI_DSI_TOP_SW_RESET_TIMING	BIT(3)
+#define MIPI_DSI_TOP_CLK_CNTL		0x3c4
+#define		MIPI_DSI_TOP_CLK_SYSCLK_EN	BIT(0)
+#define		MIPI_DSI_TOP_CLK_PIXCLK_EN	BIT(1)
+#define MIPI_DSI_TOP_CNTL		0x3c8
+#define		MIPI_DSI_TOP_DPI_COLOR_MODE	GENMASK(23, 20)
+#define		MIPI_DSI_TOP_IN_COLOR_MODE	GENMASK(18, 16)
+#define		MIPI_DSI_TOP_COMP2_SEL		GENMASK(13, 12)
+#define		MIPI_DSI_TOP_COMP1_SEL		GENMASK(11, 10)
+#define		MIPI_DSI_TOP_COMP0_SEL		GENMASK(9, 8)
+#define MIPI_DSI_TOP_MEM_PD		0x3f4
+
+#define VENC_IN_COLOR_24B		0x1
+#define VENC_IN_COLOR_18B		0x2
+#define DPI_COLOR_18BIT_CFG_2		4
+#define DPI_COLOR_24BIT			5
+
+/* HHI clock registers */
+#define HHI_GP0_PLL_CNTL0		0x040
+#define		GP0_PLL_LOCK			BIT(31)
+#define		GP0_PLL_RST			BIT(29)
+#define		GP0_PLL_EN			BIT(28)
+#define		GP0_PLL_OD			GENMASK(18, 16)
+#define		GP0_PLL_N			GENMASK(14, 10)
+#define		GP0_PLL_M			GENMASK(7, 0)
+#define HHI_GP0_PLL_CNTL1		0x044
+#define HHI_GP0_PLL_CNTL2		0x048
+#define HHI_GP0_PLL_CNTL3		0x04c
+#define HHI_GP0_PLL_CNTL4		0x050
+#define HHI_GP0_PLL_CNTL5		0x054
+#define HHI_GP0_PLL_CNTL6		0x058
+#define HHI_VIID_CLK_DIV		0x128
+#define		VIID_CLK_DIV_XD			GENMASK(7, 0)
+#define		VIID_CLK_DIV_ENCL_SEL		GENMASK(15, 12)
+#define		VIID_CLK_DIV_EN			BIT(16)
+#define		VIID_CLK_DIV_RST		BIT(17)
+#define HHI_VIID_CLK_CNTL		0x12c
+#define		VIID_CLK_CNTL_DIV1_EN		BIT(0)
+#define		VIID_CLK_CNTL_SOFT_RST		BIT(15)
+#define		VIID_CLK_CNTL_SEL		GENMASK(18, 16)
+#define		VIID_CLK_CNTL_EN		BIT(19)
+#define HHI_VID_CLK_CNTL2		0x194
+#define		VID_CLK_CNTL2_ENCL_GATE		BIT(3)
+#define HHI_MIPIDSI_PHY_CLK_CNTL	0x254
+#define		MIPIDSI_PXCLK_DIV		GENMASK(6, 0)
+#define		MIPIDSI_PXCLK_EN		BIT(8)
+#define		MIPIDSI_PXCLK_SEL		GENMASK(14, 12)
+
+#define CLK_SRC_GP0			1	/* VCLK2 and DSI pxclk muxes */
+#define CTS_ENCL_SEL_VCLK2_DIV1		8
+
+#define XTAL_RATE			24000000UL
+#define GP0_M_MIN			125
+#define GP0_M_MAX			255
+
+struct meson_dw_mipi_dsi_priv {
+	void __iomem *base;
+	struct regmap *hhi;
+	struct clk pclk;
+	struct reset_ctl top_rst;
+	struct phy phy;
+	struct phy_configure_opts_mipi_dphy phy_opts;
+	struct mipi_dsi_device device;
+	struct udevice *panel;
+	struct udevice *dsi_host;
+	struct display_timing timings;
+	unsigned int bpp;
+};
+
+static struct meson_dw_mipi_dsi_priv *dsi_priv(void *priv_data)
+{
+	struct mipi_dsi_device *device = priv_data;
+
+	return dev_get_priv(device->dev);
+}
+
+/*
+ * Pick an integer GP0 PLL setting for the wanted rate:
+ * rate = 24 MHz * m >> od, with the DCO (24 MHz * m) at 3 - 6.12 GHz.
+ * Returns the real rate.
+ */
+static unsigned long meson_dsi_gp0_calc(unsigned long rate, unsigned int *m,
+					unsigned int *od)
+{
+	unsigned int i;
+
+	for (i = 0; i <= 4; i++) {
+		u64 dco = (u64)rate << i;
+		unsigned long mm = DIV_ROUND_CLOSEST_ULL(dco, XTAL_RATE);
+
+		if (mm < GP0_M_MIN || mm > GP0_M_MAX)
+			continue;
+
+		*m = mm;
+		*od = i;
+		return (XTAL_RATE * mm) >> i;
+	}
+
+	return 0;
+}
+
+static int meson_dsi_set_gp0(struct meson_dw_mipi_dsi_priv *priv,
+			     unsigned int m, unsigned int od)
+{
+	unsigned int val;
+	int ret;
+
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL0,
+		     GP0_PLL_RST | GP0_PLL_EN |
+		     FIELD_PREP(GP0_PLL_OD, od) |
+		     FIELD_PREP(GP0_PLL_N, 1) |
+		     FIELD_PREP(GP0_PLL_M, m));
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL1, 0);
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL2, 0);
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL3, 0x48681c00);
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL4, 0x33771290);
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL5, 0x39272000);
+	regmap_write(priv->hhi, HHI_GP0_PLL_CNTL6, 0x56540000);
+	udelay(100);
+	regmap_update_bits(priv->hhi, HHI_GP0_PLL_CNTL0, GP0_PLL_RST, 0);
+
+	ret = regmap_read_poll_timeout(priv->hhi, HHI_GP0_PLL_CNTL0, val,
+				       val & GP0_PLL_LOCK, 10, 10000);
+	if (ret)
+		return -EIO;
+
+	return 0;
+}
+
+static void meson_dsi_set_clocks(struct meson_dw_mipi_dsi_priv *priv,
+				 unsigned int encl_div)
+{
+	/* DSI bit clock: GP0 / 1 */
+	regmap_update_bits(priv->hhi, HHI_MIPIDSI_PHY_CLK_CNTL,
+			   MIPIDSI_PXCLK_SEL | MIPIDSI_PXCLK_DIV,
+			   FIELD_PREP(MIPIDSI_PXCLK_SEL, CLK_SRC_GP0));
+	regmap_update_bits(priv->hhi, HHI_MIPIDSI_PHY_CLK_CNTL,
+			   MIPIDSI_PXCLK_EN, MIPIDSI_PXCLK_EN);
+
+	/* ENCL pixel clock: GP0 -> VCLK2 / encl_div -> vclk2_div1 -> cts_encl */
+	regmap_update_bits(priv->hhi, HHI_VID_CLK_CNTL2,
+			   VID_CLK_CNTL2_ENCL_GATE, 0);
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_CNTL, VIID_CLK_CNTL_EN, 0);
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_DIV,
+			   VIID_CLK_DIV_EN | VIID_CLK_DIV_RST, 0);
+
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_DIV, VIID_CLK_DIV_XD,
+			   FIELD_PREP(VIID_CLK_DIV_XD, encl_div - 1));
+	udelay(5);
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_CNTL, VIID_CLK_CNTL_SEL,
+			   FIELD_PREP(VIID_CLK_CNTL_SEL, CLK_SRC_GP0));
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_CNTL, VIID_CLK_CNTL_EN,
+			   VIID_CLK_CNTL_EN);
+	udelay(2);
+
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_DIV, VIID_CLK_DIV_ENCL_SEL,
+			   FIELD_PREP(VIID_CLK_DIV_ENCL_SEL,
+				      CTS_ENCL_SEL_VCLK2_DIV1));
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_DIV, VIID_CLK_DIV_EN,
+			   VIID_CLK_DIV_EN);
+	udelay(5);
+
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_CNTL, VIID_CLK_CNTL_DIV1_EN,
+			   VIID_CLK_CNTL_DIV1_EN);
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_CNTL, VIID_CLK_CNTL_SOFT_RST,
+			   VIID_CLK_CNTL_SOFT_RST);
+	udelay(10);
+	regmap_update_bits(priv->hhi, HHI_VIID_CLK_CNTL, VIID_CLK_CNTL_SOFT_RST,
+			   0);
+	udelay(5);
+
+	regmap_update_bits(priv->hhi, HHI_VID_CLK_CNTL2,
+			   VID_CLK_CNTL2_ENCL_GATE, VID_CLK_CNTL2_ENCL_GATE);
+}
+
+static void meson_dw_mipi_dsi_hw_init(struct meson_dw_mipi_dsi_priv *priv)
+{
+	const u32 rst = MIPI_DSI_TOP_SW_RESET_DWC | MIPI_DSI_TOP_SW_RESET_INTR |
+			MIPI_DSI_TOP_SW_RESET_DPI | MIPI_DSI_TOP_SW_RESET_TIMING;
+
+	/* Software reset */
+	writel_bits(rst, rst, priv->base + MIPI_DSI_TOP_SW_RESET);
+	writel_bits(rst, 0, priv->base + MIPI_DSI_TOP_SW_RESET);
+
+	/* Enable clocks */
+	writel_bits(MIPI_DSI_TOP_CLK_SYSCLK_EN | MIPI_DSI_TOP_CLK_PIXCLK_EN,
+		    MIPI_DSI_TOP_CLK_SYSCLK_EN | MIPI_DSI_TOP_CLK_PIXCLK_EN,
+		    priv->base + MIPI_DSI_TOP_CLK_CNTL);
+
+	/* Take memory out of power down */
+	writel(0, priv->base + MIPI_DSI_TOP_MEM_PD);
+}
+
+static int dsi_phy_init(void *priv_data)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dsi_priv(priv_data);
+	unsigned int dpi_data_format, venc_data_width;
+	int ret;
+
+	switch (priv->device.format) {
+	case MIPI_DSI_FMT_RGB888:
+		dpi_data_format = DPI_COLOR_24BIT;
+		venc_data_width = VENC_IN_COLOR_24B;
+		break;
+	case MIPI_DSI_FMT_RGB666:
+		dpi_data_format = DPI_COLOR_18BIT_CFG_2;
+		venc_data_width = VENC_IN_COLOR_18B;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Configure color format for DPI register */
+	writel(FIELD_PREP(MIPI_DSI_TOP_DPI_COLOR_MODE, dpi_data_format) |
+	       FIELD_PREP(MIPI_DSI_TOP_IN_COLOR_MODE, venc_data_width) |
+	       FIELD_PREP(MIPI_DSI_TOP_COMP2_SEL, 2) |
+	       FIELD_PREP(MIPI_DSI_TOP_COMP1_SEL, 1) |
+	       FIELD_PREP(MIPI_DSI_TOP_COMP0_SEL, 0),
+	       priv->base + MIPI_DSI_TOP_CNTL);
+
+	ret = generic_phy_configure(&priv->phy, &priv->phy_opts);
+	if (ret) {
+		log_err("failed to configure the DSI PHY (%d)\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int dsi_get_lane_mbps(void *priv_data, struct display_timing *timings,
+			     u32 lanes, u32 format, unsigned int *lane_mbps)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dsi_priv(priv_data);
+
+	*lane_mbps = DIV_ROUND_UP(priv->phy_opts.hs_clk_rate, 1000000);
+
+	return 0;
+}
+
+static int dsi_phy_get_timing(void *priv_data, unsigned int lane_mbps,
+			      struct mipi_dsi_phy_timing *timing)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dsi_priv(priv_data);
+
+	switch (priv->timings.hactive.typ) {
+	case 240:
+	case 768:
+	case 1920:
+	case 2560:
+		timing->clk_lp2hs = 23;
+		timing->clk_hs2lp = 38;
+		timing->data_lp2hs = 15;
+		timing->data_hs2lp = 9;
+		break;
+	default:
+		timing->clk_lp2hs = 37;
+		timing->clk_hs2lp = 135;
+		timing->data_lp2hs = 50;
+		timing->data_hs2lp = 3;
+	}
+
+	return 0;
+}
+
+static void dsi_get_esc_clk_rate(void *priv_data, unsigned int *esc_clk_rate)
+{
+	*esc_clk_rate = 4; /* MHz */
+}
+
+static const struct mipi_dsi_phy_ops meson_dsi_phy_ops = {
+	.init = dsi_phy_init,
+	.get_lane_mbps = dsi_get_lane_mbps,
+	.get_timing = dsi_phy_get_timing,
+	.get_esc_clk_rate = dsi_get_esc_clk_rate,
+};
+
+static int meson_dw_mipi_dsi_attach(struct udevice *dev)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_device *device = &priv->device;
+	struct display_timing *timings = &priv->timings;
+	struct mipi_dsi_panel_plat *mplat;
+	unsigned long hs_rate, rate;
+	unsigned int m, od, encl_div;
+	int ret;
+
+	ret = uclass_first_device_err(UCLASS_PANEL, &priv->panel);
+	if (ret) {
+		dev_err(dev, "panel device error %d\n", ret);
+		return ret;
+	}
+
+	mplat = dev_get_plat(priv->panel);
+	mplat->device = device;
+	device->lanes = mplat->lanes;
+	device->format = mplat->format;
+	device->mode_flags = mplat->mode_flags;
+
+	ret = panel_get_display_timing(priv->panel, timings);
+	if (ret) {
+		ret = ofnode_decode_display_timing(dev_ofnode(priv->panel),
+						   0, timings);
+		if (ret) {
+			dev_err(dev, "decode display timing error %d\n", ret);
+			return ret;
+		}
+	}
+
+	if (device->format != MIPI_DSI_FMT_RGB888 &&
+	    device->format != MIPI_DSI_FMT_RGB666) {
+		dev_err(dev, "invalid pixel format %d\n", device->format);
+		return -EINVAL;
+	}
+
+	priv->bpp = mipi_dsi_pixel_format_to_bpp(device->format);
+	if (!device->lanes || priv->bpp % device->lanes) {
+		dev_err(dev, "unsupported lanes/format %u/%d\n",
+			device->lanes, device->format);
+		return -EINVAL;
+	}
+	encl_div = priv->bpp / device->lanes;
+
+	/*
+	 * One PLL feeds both clocks: lane bit rate = pixel clock * bpp / lanes
+	 * and pixel clock = bit rate / encl_div, so round the pixel clock to
+	 * what GP0 can do.
+	 */
+	hs_rate = meson_dsi_gp0_calc(timings->pixelclock.typ * encl_div,
+				     &m, &od);
+	if (!hs_rate) {
+		dev_err(dev, "pixel clock %u out of range\n",
+			timings->pixelclock.typ);
+		return -EINVAL;
+	}
+	rate = hs_rate / encl_div;
+	dev_dbg(dev, "pixel clock %u -> %lu Hz, lane rate %lu Hz\n",
+		timings->pixelclock.typ, rate, hs_rate);
+	timings->pixelclock.typ = rate;
+
+	ret = phy_mipi_dphy_get_default_config(rate, priv->bpp, device->lanes,
+					       &priv->phy_opts);
+	if (ret)
+		return ret;
+	priv->phy_opts.hs_clk_rate = hs_rate;
+
+	ret = meson_dsi_set_gp0(priv, m, od);
+	if (ret) {
+		dev_err(dev, "GP0 PLL failed to lock\n");
+		return ret;
+	}
+	meson_dsi_set_clocks(priv, encl_div);
+
+	ret = generic_phy_init(&priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to init the DSI PHY (%d)\n", ret);
+		return ret;
+	}
+
+	meson_dw_mipi_dsi_hw_init(priv);
+
+	ret = uclass_get_device(UCLASS_DSI_HOST, 0, &priv->dsi_host);
+	if (ret) {
+		dev_err(dev, "No video dsi host detected %d\n", ret);
+		return ret;
+	}
+
+	ret = dsi_host_init(priv->dsi_host, device, timings, 4,
+			    &meson_dsi_phy_ops);
+	if (ret) {
+		dev_err(dev, "failed to initialize mipi dsi host\n");
+		return ret;
+	}
+
+	/* As in Linux: the D-PHY is powered on once the host is set up */
+	ret = generic_phy_power_on(&priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to power on the DSI PHY (%d)\n", ret);
+		return ret;
+	}
+
+	/* No serial port on these boards: leave a trace in the console log */
+	printf("DSI:   %ux%u, %u lanes, %lu kHz pixel clock, phy status %#x\n",
+	       timings->hactive.typ, timings->vactive.typ, device->lanes,
+	       rate / 1000, readl(priv->base + 0xb0));
+
+	return 0;
+}
+
+static int meson_dw_mipi_dsi_get_display_timing(struct udevice *dev,
+						struct display_timing *timing)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+
+	if (!priv->panel)
+		return -ENODEV;
+
+	memcpy(timing, &priv->timings, sizeof(*timing));
+
+	return 0;
+}
+
+static int meson_dw_mipi_dsi_set_backlight(struct udevice *dev, int percent)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	/* Sends the panel init sequence (command mode) and turns it on */
+	ret = panel_enable_backlight(priv->panel);
+	if (ret) {
+		dev_err(dev, "panel %s enable backlight error %d\n",
+			priv->panel->name, ret);
+		return ret;
+	}
+
+	ret = dsi_host_enable(priv->dsi_host);
+	if (ret) {
+		dev_err(dev, "failed to enable mipi dsi host\n");
+		return ret;
+	}
+
+	if (percent >= 0)
+		panel_set_backlight(priv->panel, percent);
+
+	return 0;
+}
+
+static int meson_dw_mipi_dsi_bind(struct udevice *dev)
+{
+	int ret;
+
+	ret = device_bind_driver_to_node(dev, "dw_mipi_dsi", "dsihost",
+					 dev_ofnode(dev), NULL);
+	if (ret)
+		return ret;
+
+	/* the panel */
+	return dm_scan_fdt_dev(dev);
+}
+
+static int meson_dw_mipi_dsi_probe(struct udevice *dev)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	ofnode hhi;
+	int ret;
+
+	priv->device.dev = dev;
+
+	priv->base = dev_read_addr_ptr(dev);
+	if (!priv->base)
+		return -EINVAL;
+
+	hhi = ofnode_by_compatible(ofnode_null(), "amlogic,meson-gx-hhi-sysctrl");
+	if (!ofnode_valid(hhi))
+		return -ENODEV;
+	priv->hhi = syscon_node_to_regmap(hhi);
+	if (IS_ERR(priv->hhi))
+		return PTR_ERR(priv->hhi);
+
+	ret = generic_phy_get_by_name(dev, "dphy", &priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to get mipi dphy (%d)\n", ret);
+		return ret;
+	}
+
+	ret = clk_get_by_name(dev, "pclk", &priv->pclk);
+	if (ret) {
+		dev_err(dev, "failed to get pclk (%d)\n", ret);
+		return ret;
+	}
+	ret = clk_enable(&priv->pclk);
+	if (ret) {
+		dev_err(dev, "failed to enable pclk (%d)\n", ret);
+		return ret;
+	}
+
+	/*
+	 * A TOP reset signal is used because the APB reset signal is handled
+	 * by the TOP control registers.
+	 */
+	ret = reset_get_by_name(dev, "top", &priv->top_rst);
+	if (ret) {
+		dev_err(dev, "failed to get the top reset (%d)\n", ret);
+		return ret;
+	}
+	reset_assert(&priv->top_rst);
+	udelay(20);
+	reset_deassert(&priv->top_rst);
+
+	return 0;
+}
+
+static const struct video_bridge_ops meson_dw_mipi_dsi_ops = {
+	.attach = meson_dw_mipi_dsi_attach,
+	.set_backlight = meson_dw_mipi_dsi_set_backlight,
+	.get_display_timing = meson_dw_mipi_dsi_get_display_timing,
+};
+
+static const struct udevice_id meson_dw_mipi_dsi_ids[] = {
+	{ .compatible = "amlogic,meson-g12a-dw-mipi-dsi" },
+	{ }
+};
+
+U_BOOT_DRIVER(meson_dw_mipi_dsi) = {
+	.name		= "meson_dw_mipi_dsi",
+	.id		= UCLASS_VIDEO_BRIDGE,
+	.of_match	= meson_dw_mipi_dsi_ids,
+	.bind		= meson_dw_mipi_dsi_bind,
+	.probe		= meson_dw_mipi_dsi_probe,
+	.ops		= &meson_dw_mipi_dsi_ops,
+	.priv_auto	= sizeof(struct meson_dw_mipi_dsi_priv),
+};
diff --git a/drivers/video/meson/meson_registers.h b/drivers/video/meson/meson_registers.h
index f6a5d1ac..50fb4c28 100644
--- a/drivers/video/meson/meson_registers.h
+++ b/drivers/video/meson/meson_registers.h
@@ -1738,4 +1738,17 @@
 #define VPP_RDARB_MODE 0x3978
 #define VPP_RDARB_REQEN_SLV 0x3979
 
+
+/* ENCL (LCD encoder) fields */
+#define		ENCL_PX_LN_CNT_SHADOW_EN		BIT(15)
+#define		ENCL_VIDEO_MODE_ADV_VFIFO_EN		BIT(3)
+#define		ENCL_VIDEO_MODE_ADV_GAIN_HDTV		BIT(4)
+#define		ENCL_SEL_GAMMA_RGB_IN			BIT(10)
+#define		ENCL_VIDEO_FILT_CTRL_BYPASS_FILTER	BIT(12)
+#define		ENCL_VIDEO_RGBIN_RGB			BIT(0)
+#define		ENCL_VIDEO_RGBIN_ZBLK			BIT(1)
+#define		L_DITH_CNTL_DITH10_EN			BIT(10)
+#define		L_TCON_MISC_SEL_STV1			BIT(4)
+#define		L_TCON_MISC_SEL_STV2			BIT(5)
+
 #endif /* __MESON_REGISTERS_H */
diff --git a/drivers/video/meson/meson_venc.c b/drivers/video/meson/meson_venc.c
index 1bc6aaf7..a94edd30 100644
--- a/drivers/video/meson/meson_venc.c
+++ b/drivers/video/meson/meson_venc.c
@@ -1567,3 +1567,151 @@ void meson_vpu_setup_venc(struct udevice *dev,
 
 	meson_venc_hdmi_mode_set(priv, mode);
 }
+
+/*
+ * ENCL setup for the MIPI DSI output (the DSI host takes its DPI input from
+ * ENCL). Port of the Linux meson_venc_mipi_dsi_mode_set().
+ */
+void meson_vpu_setup_venc_dsi(struct udevice *dev,
+			      const struct display_timing *mode)
+{
+	struct meson_vpu_priv *priv = dev_get_priv(dev);
+	unsigned int hdisplay = mode->hactive.typ;
+	unsigned int hsync_start = hdisplay + mode->hfront_porch.typ;
+	unsigned int hsync_end = hsync_start + mode->hsync_len.typ;
+	unsigned int htotal = hsync_end + mode->hback_porch.typ;
+	unsigned int vdisplay = mode->vactive.typ;
+	unsigned int vsync_start = vdisplay + mode->vfront_porch.typ;
+	unsigned int vsync_end = vsync_start + mode->vsync_len.typ;
+	unsigned int vtotal = vsync_end + mode->vback_porch.typ;
+	unsigned int max_pxcnt = htotal - 1;
+	unsigned int max_lncnt = vtotal - 1;
+	unsigned int havon_begin = htotal - hsync_start;
+	unsigned int havon_end = havon_begin + hdisplay - 1;
+	unsigned int vavon_bline = vtotal - vsync_start;
+	unsigned int vavon_eline = vavon_bline + vdisplay - 1;
+	unsigned int hso_begin = 0;
+	unsigned int hso_end = hsync_end - hsync_start;
+	unsigned int vso_begin = 0;
+	unsigned int vso_end = 0;
+	unsigned int vso_bline = 0;
+	unsigned int vso_eline = vsync_end - vsync_start;
+
+	meson_vpp_setup_mux(priv, MESON_VIU_VPP_MUX_ENCL);
+
+	writel(0, priv->io_base + _REG(ENCL_VIDEO_EN));
+
+	writel(ENCL_PX_LN_CNT_SHADOW_EN, priv->io_base + _REG(ENCL_VIDEO_MODE));
+	writel(ENCL_VIDEO_MODE_ADV_VFIFO_EN | ENCL_VIDEO_MODE_ADV_GAIN_HDTV |
+	       ENCL_SEL_GAMMA_RGB_IN, priv->io_base + _REG(ENCL_VIDEO_MODE_ADV));
+
+	writel(ENCL_VIDEO_FILT_CTRL_BYPASS_FILTER,
+	       priv->io_base + _REG(ENCL_VIDEO_FILT_CTRL));
+	writel(max_pxcnt, priv->io_base + _REG(ENCL_VIDEO_MAX_PXCNT));
+	writel(max_lncnt, priv->io_base + _REG(ENCL_VIDEO_MAX_LNCNT));
+	writel(havon_begin, priv->io_base + _REG(ENCL_VIDEO_HAVON_BEGIN));
+	writel(havon_end, priv->io_base + _REG(ENCL_VIDEO_HAVON_END));
+	writel(vavon_bline, priv->io_base + _REG(ENCL_VIDEO_VAVON_BLINE));
+	writel(vavon_eline, priv->io_base + _REG(ENCL_VIDEO_VAVON_ELINE));
+
+	writel(hso_begin, priv->io_base + _REG(ENCL_VIDEO_HSO_BEGIN));
+	writel(hso_end, priv->io_base + _REG(ENCL_VIDEO_HSO_END));
+	writel(vso_begin, priv->io_base + _REG(ENCL_VIDEO_VSO_BEGIN));
+	writel(vso_end, priv->io_base + _REG(ENCL_VIDEO_VSO_END));
+	writel(vso_bline, priv->io_base + _REG(ENCL_VIDEO_VSO_BLINE));
+	writel(vso_eline, priv->io_base + _REG(ENCL_VIDEO_VSO_ELINE));
+	writel(ENCL_VIDEO_RGBIN_RGB | ENCL_VIDEO_RGBIN_ZBLK,
+	       priv->io_base + _REG(ENCL_VIDEO_RGBIN_CTRL));
+
+	/* default black pattern */
+	writel(0, priv->io_base + _REG(ENCL_TST_MDSEL));
+	writel(0, priv->io_base + _REG(ENCL_TST_Y));
+	writel(0, priv->io_base + _REG(ENCL_TST_CB));
+	writel(0, priv->io_base + _REG(ENCL_TST_CR));
+	writel(1, priv->io_base + _REG(ENCL_TST_EN));
+	writel_bits(ENCL_VIDEO_MODE_ADV_VFIFO_EN, 0,
+		    priv->io_base + _REG(ENCL_VIDEO_MODE_ADV));
+
+	writel(1, priv->io_base + _REG(ENCL_VIDEO_EN));
+
+	writel(0, priv->io_base + _REG(L_RGB_BASE_ADDR));
+	writel(0x400, priv->io_base + _REG(L_RGB_COEFF_ADDR)); /* Magic value */
+
+	writel(L_DITH_CNTL_DITH10_EN, priv->io_base + _REG(L_DITH_CNTL_ADDR));
+
+	/* DE signal for TTL */
+	writel(havon_begin, priv->io_base + _REG(L_OEH_HS_ADDR));
+	writel(havon_end + 1, priv->io_base + _REG(L_OEH_HE_ADDR));
+	writel(vavon_bline, priv->io_base + _REG(L_OEH_VS_ADDR));
+	writel(vavon_eline, priv->io_base + _REG(L_OEH_VE_ADDR));
+
+	/* DE signal for TTL */
+	writel(havon_begin, priv->io_base + _REG(L_OEV1_HS_ADDR));
+	writel(havon_end + 1, priv->io_base + _REG(L_OEV1_HE_ADDR));
+	writel(vavon_bline, priv->io_base + _REG(L_OEV1_VS_ADDR));
+	writel(vavon_eline, priv->io_base + _REG(L_OEV1_VE_ADDR));
+
+	/* Hsync signal for TTL */
+	if (mode->flags & DISPLAY_FLAGS_HSYNC_HIGH) {
+		writel(hso_begin, priv->io_base + _REG(L_STH1_HS_ADDR));
+		writel(hso_end, priv->io_base + _REG(L_STH1_HE_ADDR));
+	} else {
+		writel(hso_end, priv->io_base + _REG(L_STH1_HS_ADDR));
+		writel(hso_begin, priv->io_base + _REG(L_STH1_HE_ADDR));
+	}
+	writel(0, priv->io_base + _REG(L_STH1_VS_ADDR));
+	writel(max_lncnt, priv->io_base + _REG(L_STH1_VE_ADDR));
+
+	/* Vsync signal for TTL */
+	writel(vso_begin, priv->io_base + _REG(L_STV1_HS_ADDR));
+	writel(vso_end, priv->io_base + _REG(L_STV1_HE_ADDR));
+	if (mode->flags & DISPLAY_FLAGS_VSYNC_HIGH) {
+		writel(vso_bline, priv->io_base + _REG(L_STV1_VS_ADDR));
+		writel(vso_eline, priv->io_base + _REG(L_STV1_VE_ADDR));
+	} else {
+		writel(vso_eline, priv->io_base + _REG(L_STV1_VS_ADDR));
+		writel(vso_bline, priv->io_base + _REG(L_STV1_VE_ADDR));
+	}
+
+	/* DE signal */
+	writel(havon_begin, priv->io_base + _REG(L_DE_HS_ADDR));
+	writel(havon_end + 1, priv->io_base + _REG(L_DE_HE_ADDR));
+	writel(vavon_bline, priv->io_base + _REG(L_DE_VS_ADDR));
+	writel(vavon_eline, priv->io_base + _REG(L_DE_VE_ADDR));
+
+	/* Hsync signal */
+	writel(hso_begin, priv->io_base + _REG(L_HSYNC_HS_ADDR));
+	writel(hso_end, priv->io_base + _REG(L_HSYNC_HE_ADDR));
+	writel(0, priv->io_base + _REG(L_HSYNC_VS_ADDR));
+	writel(max_lncnt, priv->io_base + _REG(L_HSYNC_VE_ADDR));
+
+	/* Vsync signal */
+	writel(vso_begin, priv->io_base + _REG(L_VSYNC_HS_ADDR));
+	writel(vso_end, priv->io_base + _REG(L_VSYNC_HE_ADDR));
+	writel(vso_bline, priv->io_base + _REG(L_VSYNC_VS_ADDR));
+	writel(vso_eline, priv->io_base + _REG(L_VSYNC_VE_ADDR));
+
+	writel(0, priv->io_base + _REG(L_INV_CNT_ADDR));
+	writel(L_TCON_MISC_SEL_STV1 | L_TCON_MISC_SEL_STV2,
+	       priv->io_base + _REG(L_TCON_MISC_SEL_ADDR));
+}
+
+/*
+ * Start the ENCL output once the DSI host is up, as the Linux
+ * meson_encoder_dsi_atomic_enable() does. The panel takes RGB, so the OSD1
+ * RGB to YUV matrix (loaded for HDMI) is bypassed.
+ */
+void meson_vpu_enable_venc_dsi(struct udevice *dev)
+{
+	struct meson_vpu_priv *priv = dev_get_priv(dev);
+
+	writel(0, priv->io_base + _REG(ENCL_VIDEO_EN));
+
+	writel_bits(ENCL_VIDEO_MODE_ADV_VFIFO_EN, ENCL_VIDEO_MODE_ADV_VFIFO_EN,
+		    priv->io_base + _REG(ENCL_VIDEO_MODE_ADV));
+	writel(0, priv->io_base + _REG(ENCL_TST_EN));
+
+	writel_bits(BIT(0), 0, priv->io_base + _REG(VPP_WRAP_OSD1_MATRIX_EN_CTRL));
+
+	writel(1, priv->io_base + _REG(ENCL_VIDEO_EN));
+}
diff --git a/drivers/video/meson/meson_vpu.c b/drivers/video/meson/meson_vpu.c
index a686faf9..cafcf2d5 100644
--- a/drivers/video/meson/meson_vpu.c
+++ b/drivers/video/meson/meson_vpu.c
@@ -12,6 +12,7 @@
 #include <fdt_support.h>
 #include <log.h>
 #include <part.h>
+#include <video_bridge.h>
 #include <linux/sizes.h>
 #include <asm/arch/mem.h>
 #include <asm/global_data.h>
@@ -31,6 +32,7 @@ static struct meson_framebuffer {
 	unsigned int xsize;
 	unsigned int ysize;
 	bool is_cvbs;
+	bool is_dsi;
 } meson_fb = { 0 };
 
 bool meson_vpu_is_compatible(struct meson_vpu_priv *priv,
@@ -96,6 +98,68 @@ cvbs:
 	return 0;
 }
 
+/*
+ * MIPI DSI panel: the meson_dw_mipi_dsi bridge brings up the clocks, the PHY
+ * and the DSI host, the VPU feeds it from ENCL.
+ */
+static int meson_vpu_setup_dsi(struct udevice *dev, struct udevice *bridge)
+{
+	struct video_uc_plat *uc_plat = dev_get_uclass_plat(dev);
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct display_timing timing;
+	struct udevice *panel;
+	u32 rotation;
+	int ret;
+
+	ret = video_bridge_attach(bridge);
+	if (ret) {
+		debug("%s: DSI attach failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	ret = video_bridge_get_display_timing(bridge, &timing);
+	if (ret)
+		return ret;
+
+	uc_priv->xsize = timing.hactive.typ;
+	uc_priv->ysize = timing.vactive.typ;
+	uc_priv->bpix = VPU_MAX_LOG2_BPP;
+
+	/* "rotation" of the panel (as in Linux) turns the console */
+	if (IS_ENABLED(CONFIG_CONSOLE_ROTATION) &&
+	    !uclass_first_device_err(UCLASS_PANEL, &panel) &&
+	    !dev_read_u32(panel, "rotation", &rotation))
+		uc_priv->rot = (rotation / 90) & 3;
+
+	meson_fb.is_cvbs = false;
+	meson_fb.is_dsi = true;
+	meson_fb.xsize = uc_priv->xsize;
+	meson_fb.ysize = uc_priv->ysize;
+
+	/* Move the framebuffer to the end of addressable ram */
+	meson_fb.fb_size = ALIGN(meson_fb.xsize * meson_fb.ysize *
+				 ((1 << VPU_MAX_LOG2_BPP) / 8) +
+				 MESON_VPU_OVERSCAN, EFI_PAGE_SIZE);
+	meson_fb.base = gd->dram[0].start +
+			gd->dram[0].size - meson_fb.fb_size;
+
+	/* Override the framebuffer address */
+	uc_plat->base = meson_fb.base;
+
+	meson_vpu_setup_plane(dev, false);
+	meson_vpu_setup_venc_dsi(dev, &timing);
+	meson_vpu_enable_venc_dsi(dev);
+
+	/* Panel init sequence, DSI video mode, then the backlight */
+	ret = video_bridge_set_backlight(bridge, 80);
+	if (ret)
+		return ret;
+
+	video_set_flush_dcache(dev, 1);
+
+	return 0;
+}
+
 static const struct udevice_id meson_vpu_ids[] = {
 	{ .compatible = "amlogic,meson-gxbb-vpu", .data = VPU_COMPATIBLE_GXBB },
 	{ .compatible = "amlogic,meson-gxl-vpu", .data = VPU_COMPATIBLE_GXL },
@@ -130,6 +194,16 @@ static int meson_vpu_probe(struct udevice *dev)
 
 	meson_vpu_init(dev);
 
+	/* a MIPI DSI panel comes first */
+	if (IS_ENABLED(CONFIG_VIDEO_MESON_DW_MIPI_DSI) &&
+	    !uclass_first_device_err(UCLASS_VIDEO_BRIDGE, &disp)) {
+		ret = meson_vpu_setup_dsi(dev, disp);
+		if (!ret)
+			return 0;
+		printf("meson_vpu: DSI panel setup failed (%d)\n", ret);
+		meson_fb.is_dsi = false;
+	}
+
 	/* probe the display */
 	ret = uclass_get_device(UCLASS_DISPLAY, 0, &disp);
 
@@ -155,6 +229,8 @@ static void meson_vpu_setup_simplefb(void *fdt)
 
 	if (meson_fb.is_cvbs)
 		pipeline = "vpu-cvbs";
+	else if (meson_fb.is_dsi)
+		pipeline = "vpu-dsi";
 	else
 		pipeline = "vpu-hdmi";
 
